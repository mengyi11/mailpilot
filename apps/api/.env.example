APP_NAME=MailPilot API
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://mailpilot:mailpilot_dev@localhost:5432/mailpilot

# Google OAuth values stay in the FastAPI environment only. Never expose them
# through NEXT_PUBLIC_* variables or send them to Dify.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-local-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_SCOPES=["https://www.googleapis.com/auth/gmail.readonly"]
OAUTH_STATE_SECRET=replace-with-a-long-random-string
OAUTH_STATE_MAX_AGE_SECONDS=600
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
TOKEN_ENCRYPTION_KEY_VERSION=v1
FRONTEND_OAUTH_SUCCESS_URL=http://localhost:3000/settings/accounts
GMAIL_SYNC_LIMIT=100
GMAIL_SYNC_CONCURRENCY=5
GMAIL_SYNC_MAX_RETRIES=3
# Email processing
EMAIL_USER_TIMEZONE=Asia/Singapore
ATTACHMENT_MAX_SIZE_BYTES=10485760
ATTACHMENT_MAX_PER_EMAIL=10
