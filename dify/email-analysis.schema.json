{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MailPilotEmailAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "email_id",
    "category",
    "priority",
    "summary",
    "translation_needed",
    "evidence",
    "actions",
    "extracted_dates"
  ],
  "properties": {
    "email_id": { "type": "string", "format": "uuid" },
    "category": {
      "type": "string",
      "enum": ["工作", "学习", "财务", "活动", "通知", "营销", "个人", "垃圾邮件"]
    },
    "priority": { "type": "string", "enum": ["low", "normal", "high"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "translation_needed": { "type": "boolean" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "maxItems": 20
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" },
      "maxItems": 20
    },
    "extracted_dates": {
      "type": "array",
      "items": { "$ref": "#/$defs/extractedDate" },
      "maxItems": 20
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source", "confidence"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "enum": ["subject", "email_body", "attachment"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "due_at", "evidence", "confidence"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "due_at": { "type": ["string", "null"], "format": "date-time" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "extractedDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "start", "end", "timezone", "location", "description", "evidence", "confidence"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": ["string", "null"], "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1 },
        "location": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "evidence": { "$ref": "#/$defs/evidence" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
